{
  "name": "meshrooms",
  "private": true,
  "version": "0.1.0-alpha.2",
  "description": "Local rooms for humans and independently operated agents",
  "license": "MIT",
  "repository": "github:igorls/meshrooms",
  "homepage": "https://github.com/igorls/meshrooms",
  "bugs": "https://github.com/igorls/meshrooms/issues",
  "packageManager": "bun@1.4.2",
  "engines": { "bun": "1.4.2" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "bun test ./server ./scripts",
    "test:source": "bun test ./server/node.test.ts ./server/http.test.ts ./server/instance.test.ts ./server/runtime.test.ts ./server/windows-path.test.ts ./server/peer-bridge.test.ts ./server/meshguard.test.ts ./scripts",
    "meshrooms": "bun run server/cli.ts",
    "package:runtime": "bun run scripts/package-runtime.ts",
    "daemon": "bun run server/daemon.ts",
    "start": "bun run server/daemon.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
